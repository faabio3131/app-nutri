# Desenvolvimento local. Em produção os valores ficam em /opt/fm/nutrisnap/.env (fora do Git, modo 600).
PORT=8080
GIN_MODE=release
DATABASE_URL=postgres://USUARIO:SENHA@db:5432/nutrisnap?sslmode=disable
CORS_ORIGIN=https://app.nutrisnapia.com.br

# IA (chave da FM Tecnologia; conta com faturamento ativo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Cakto: segredo do webhook (Configurações > Webhooks) e mapa oferta/produto=plano
CAKTO_WEBHOOK_SECRET=
CAKTO_PLAN_MAP=ID_OFERTA_ESSENCIAL=essencial,ID_OFERTA_PRO=pro,ID_OFERTA_POWER=power

# Opcionais
GLOBAL_DAILY_ANALYSES=3000
SIGNUP_LIMIT_PER_HOUR=5
